# --- EmailClean AI Python validation service environment ---
# Copy to `.env` and adjust.

# Port uvicorn listens on
PORT=8000

# DNS resolution timeout in seconds
DNS_TIMEOUT=3.0

# Max concurrent DNS lookups inside a batch
MAX_CONCURRENCY=50

# Batch size the service processes internally per request
BATCH_SIZE=100

# Set to "1" to allow the service to answer from cache-only for domains
# that fail DNS entirely (produces UNKNOWN instead of hard failure).
DNS_CACHE_TTL=600

# Optional: override the DNS servers used for MX/A lookups (comma separated).
# Leave empty to use the OS-configured resolvers. Set this when a LAN resolver
# is unreachable, since dnspython rotates servers and dead entries make roughly
# half of all lookups fail.
# DNS_NAMESERVERS=8.8.8.8,1.1.1.1
