# --- EmailClean AI Backend environment ---
# Copy this file to `.env` and adjust the values. Never commit real secrets.

# Port the Express API listens on
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/emailclean

# Base URL of the Python FastAPI validation service
VALIDATOR_URL=http://127.0.0.1:8000

# Comma separated list of origins allowed by CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded/parsed files are staged (relative to backend/ or absolute)
UPLOAD_DIR=./uploads

# Max upload size in bytes (default 20 MB)
MAX_FILE_SIZE=20971520

# Emails sent to the Python service per batch
VALIDATION_BATCH_SIZE=100

# How many batches are processed concurrently
VALIDATION_CONCURRENCY=4

# Per-request timeout (ms) against the Python service
VALIDATOR_TIMEOUT_MS=30000

# How long staged upload files are kept before cleanup (ms, default 1h)
UPLOAD_TTL_MS=3600000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Optional: future AI assistant. Leave empty to disable (validation never needs it).
AI_API_KEY=
AI_MODEL=gpt-4o-mini
